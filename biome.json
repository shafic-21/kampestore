{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useUniqueElementIds": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "info",
        "useFocusableInteractive": "off",
        "useSemanticElements": "off"
      }
    }
  },
  "formatter": {
    "enabled": true
  }
}
